# ============================================================================
# KrishiSetu Master Environment Configuration (Template)
# Smart India Hackathon Problem Statement ID: SIH26033
# Copy this file to .env and provide your actual local or deployment values.
# NEVER commit .env to version control.
# ============================================================================

# Platform Runtime
NODE_ENV=development
PORT=5000

# PostgreSQL Database (Supabase / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/krishisetu?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/krishisetu?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# Security & Secrets (Documented for future phases)
JWT_SECRET="dev-jwt-secret-replace-in-production"
JWT_EXPIRES_IN="7d"

# CORS Configuration
FRONTEND_URL="http://localhost:5173"

# Internal AI Microservices Connection
AI_SERVICE_URL="http://localhost:8000"

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="krishisetu-media"
R2_ENDPOINT=""
R2_PUBLIC_URL=""
